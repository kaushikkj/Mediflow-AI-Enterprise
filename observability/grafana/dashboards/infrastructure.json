      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (generation) (rate(python_gc_collections_total{job=\"mediflow-api\"}[5m]))",
          "legendFormat": "Generation {{generation}}",
          "range": true,
